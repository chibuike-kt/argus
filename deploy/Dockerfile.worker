FROM golang:1.26-alpine AS build
WORKDIR /src
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/argus-worker ./cmd/argus-worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/argus-worker /argus-worker
USER nonroot:nonroot
ENTRYPOINT ["/argus-worker"]
