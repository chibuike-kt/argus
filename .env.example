# ARGUS environment configuration. Copy to .env for local development.
# Do not commit a real .env. Secrets stay out of source control (ADR-020).

ARGUS_ENV=local
ARGUS_LOG_LEVEL=info
ARGUS_HTTP_PORT=8080
ARGUS_HTTP_READ_TIMEOUT=15s
ARGUS_SHUTDOWN_TIMEOUT=15s

# These defaults match docker-compose.yml.
ARGUS_DATABASE_URL=postgres://argus:argus@localhost:5432/argus?sslmode=disable
ARGUS_REDIS_URL=redis://localhost:6379/0

# The frontend origin internal/identity/service builds the
# verification-email link against ({base}/verify-email?token=...).
# Matches the Vite dev server's own port (vite.config.ts). Must be
# https:// when ARGUS_ENV is production.
ARGUS_PUBLIC_BASE_URL=http://localhost:5173

# DEV/TEST ONLY -- never set true in a real deployment. Makes
# cmd/argus-worker replay internal/ingestion/fixture/testdata's
# checked-in dataset into the instruments db/seed/dev_fixture_instruments.sql
# seeded (run `make seed-dev` first), so the worker has real candles to
# process locally without a live exchange.
ARGUS_DEV_FIXTURE_INGEST=false

# ADR-015 v0.2.0 (authentication). Every value below is a sensible
# local default already baked into internal/config/auth.go
# (envDefault) -- this section exists so they are discoverable and
# overridable, not because any of them is required to run locally.

# Argon2id (addendum row 2). Leave these at production strength even
# locally; internal/identity test code uses its own cheaper Params
# directly in Go, not through this env var, so lowering these here
# would only make a real local login slower to test by hand, not
# faster to unit test.
ARGUS_AUTH_ARGON_MEMORY_KIB=65536
ARGUS_AUTH_ARGON_ITERATIONS=3
ARGUS_AUTH_ARGON_PARALLELISM=1
ARGUS_AUTH_ARGON_SALT_LEN=16
ARGUS_AUTH_ARGON_KEY_LEN=32
ARGUS_AUTH_ARGON_MAX_CONCURRENT=4

# Password policy (addendum row 2).
ARGUS_AUTH_PASSWORD_MIN_LENGTH=12
ARGUS_AUTH_PASSWORD_MAX_LENGTH=128

# Sessions (addendum row 5).
ARGUS_AUTH_SESSION_IDLE_DURATION=168h
ARGUS_AUTH_SESSION_ABSOLUTE_DURATION=720h
ARGUS_AUTH_SENSITIVE_REAUTH_WINDOW=10m
ARGUS_AUTH_SESSION_TOUCH_THROTTLE=1m

# Password reset tokens (addendum row 12). The old email-verification-
# link TTL is gone with Register/VerifyEmail/ResendVerification
# themselves -- see ARGUS_AUTH_SIGNUP_CODE_TTL below.
ARGUS_AUTH_PASSWORD_RESET_TTL=1h

# Rate limits (addendum row 12).
ARGUS_AUTH_RATE_LOGIN_FAILURES_PER_ACCOUNT=5
ARGUS_AUTH_RATE_LOGIN_ATTEMPTS_PER_IP=20
ARGUS_AUTH_RATE_FORGOT_PASSWORD_PER_ACCOUNT=5
ARGUS_AUTH_RATE_FORGOT_PASSWORD_PER_IP=10

# Signup by emailed code and onboarding (ADR-015 "Signup and
# onboarding", v0.3.0).
ARGUS_AUTH_SIGNUP_CODE_TTL=10m
ARGUS_AUTH_SIGNUP_CODE_MAX_WRONG_GUESSES=5
ARGUS_AUTH_SIGNUP_CODE_RESEND_COOLDOWN=60s
ARGUS_AUTH_RATE_SIGNUP_CODES_PER_EMAIL=5
ARGUS_AUTH_RATE_SIGNUP_STARTS_PER_IP=10
ARGUS_AUTH_SIGNUP_TICKET_TTL=30m
# The server key an emailed signup code is HMAC-SHA256'd against
# before storage -- never the real value outside local/test; a real
# deployment must set its own (Config.Validate rejects this default
# in production).
ARGUS_AUTH_SIGNUP_CODE_HMAC_KEY=local-dev-only-signup-code-hmac-key-change-me
ARGUS_AUTH_DISPLAY_NAME_MAX_LENGTH=60
ARGUS_AUTH_WATCHLIST_MAX_ITEMS=50
ARGUS_AUTH_TERMS_VERSION=1

# Progressive login delay -- this brief's own addition, not addendum
# text (see internal/config/auth.go's doc comment on AuthPolicy).
ARGUS_AUTH_LOGIN_DELAY_STEP=1s
ARGUS_AUTH_LOGIN_DELAY_MAX=10s

# Session cookie (addendum row 5). Which one applies is decided by
# ARGUS_ENV, not by picking between these two directly.
ARGUS_AUTH_COOKIE_NAME_PROD=__Host-argus_session
ARGUS_AUTH_COOKIE_NAME_LOCAL=argus_session

# CSRF allow-list (addendum row 6): a state-changing request's Origin
# header must exactly match one of these. Defaults to the Vite dev
# server's own origins (`make web-dev`) so a local `docker compose up`
# plus the frontend dev server works with no extra setup.
ARGUS_AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set true only when ARGUS really does sit behind a proxy that sets
# X-Forwarded-For itself and strips any client-supplied one -- false
# (the default) means the IP recorded on sessions/auth_events is
# always the direct connection's own address.
ARGUS_AUTH_TRUST_PROXY_FOR_IP=false
