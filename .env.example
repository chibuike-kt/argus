# ARGUS environment configuration. Copy to .env for local development.
# Do not commit a real .env. Secrets stay out of source control (ADR-020).

ARGUS_ENV=local
ARGUS_LOG_LEVEL=info
ARGUS_HTTP_PORT=8080
ARGUS_HTTP_READ_TIMEOUT=15s
ARGUS_SHUTDOWN_TIMEOUT=15s

# These defaults match docker-compose.yml.
ARGUS_DATABASE_URL=postgres://argus:argus@localhost:5432/argus?sslmode=disable
ARGUS_REDIS_URL=redis://localhost:6379/0
