# Base URL for the real API. Left unset, the app calls a relative
# /api/v1 path, which the Vite dev server proxies to the Go API on
# :8080 (see vite.config.ts) -- no value needed for local dev against
# the stack described in web/README.md.
# VITE_API_BASE_URL=/api/v1

# Force every API hook to serve data derived from @/mocks/fixtures
# instead of calling the real API -- offline dev, screenshots, demos
# with no backend running. A small "Sample data" indicator appears in
# the bottom-right corner whenever this is on. Default is off (real
# API calls, honest loading/empty/error states).
# VITE_USE_FIXTURES=true
